{
  "$schema": "https://sandustry-modding.github.io/SandustryTypes/schemas/modinfo.json",
  "manifestVersion": 1,
  "id": "irishbruse.dev-tools",
  "name": "Dev Tools",
  "version": "0.0.2",
  "apiVersion": 1,
  "entry": "main.js",
  "author": "IrishBruse",
  "description": "DevTools, auto-load save, F3 overlay.",
  "dependencies": [],
  "loadOrder": -2147483648,
  "configSchema": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "labelKey": "Mod enabled",
      "descriptionKey": "Disable helpers without removing the mod."
    },
    "autoLoad": {
      "type": "boolean",
      "default": false,
      "labelKey": "Auto-load save",
      "descriptionKey": "On first load, navigate to the save below with ?db_load=."
    },
    "startSave": {
      "type": "choice",
      "default": "__storage__",
      "labelKey": "Start save",
      "descriptionKey": "Last played, or mod storage (set with api.storage from another mod). Empty storage uses last played.",
      "options": [
        {
          "value": "__last__",
          "labelKey": "Last played"
        },
        {
          "value": "__storage__",
          "labelKey": "Mod storage"
        }
      ]
    },
    "openDevTools": {
      "type": "boolean",
      "default": false,
      "labelKey": "Open DevTools on load",
      "descriptionKey": "Open DevTools when the mod loads."
    },
    "f12DevTools": {
      "type": "boolean",
      "default": false,
      "labelKey": "F12 opens DevTools",
      "descriptionKey": "F12 opens DevTools."
    },
    "f3Debug": {
      "type": "boolean",
      "default": false,
      "labelKey": "F3 debug overlay",
      "descriptionKey": "F3 toggles the debug overlay."
    },
    "crispCanvas": {
      "type": "boolean",
      "default": false,
      "labelKey": "Crisp canvas zoom",
      "descriptionKey": "Use nearest-neighbour scaling on the world canvas so zoom stays sharp instead of blurry."
    }
  }
}
